<Window x:Class="Mikrofine.HidExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mikrofine HID Explorer" Height="760" Width="1280"
        MinHeight="600" MinWidth="1000">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Width="120" Height="30" Click="Refresh_Click">Refresh</Button>
            <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold">Mikrofine HID Explorer</TextBlock>
            <TextBlock x:Name="StatusText" Margin="16,4,0,0" VerticalAlignment="Center" Foreground="Gray" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="HID Devices" Margin="0,0,8,0">
                <ListBox x:Name="DeviceList" SelectionChanged="DeviceList_SelectionChanged" DisplayMemberPath="DisplayName" />
            </GroupBox>
            <GroupBox Grid.Column="1" Header="Device Details" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="8" FontFamily="Consolas" />
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Live Input Reports">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="8">
                    <Button x:Name="MonitorButton" DockPanel.Dock="Right" Width="120" Click="Monitor_Click">Start Monitor</Button>
                    <TextBlock VerticalAlignment="Center">Press buttons, move the mouse or use the wheel. Reports appear below.</TextBlock>
                </DockPanel>
                <ListBox x:Name="ReportList" Grid.Row="1" Margin="8" FontFamily="Consolas" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
