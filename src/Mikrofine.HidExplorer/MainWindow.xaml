<Window x:Class="Mikrofine.HidExplorer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mikrofine HID Explorer" Height="900" Width="1500" MinHeight="700" MinWidth="1200"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,10"><Button DockPanel.Dock="Right" Width="120" Height="30" Click="Refresh_Click">Refresh</Button><TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold">Mikrofine HID Explorer</TextBlock><TextBlock x:Name="StatusText" Margin="16,4,0,0" VerticalAlignment="Center" Foreground="Gray"/></DockPanel><Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><GroupBox Header="HID Devices" Margin="0,0,8,0"><ListBox x:Name="DeviceList" SelectionChanged="DeviceList_SelectionChanged" DisplayMemberPath="DisplayName"/></GroupBox><Grid Grid.Column="1" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions><GroupBox Header="Decoded Device Details" Margin="0,0,0,6"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="8" FontFamily="Consolas"/></ScrollViewer></GroupBox><GroupBox Grid.Row="1" Header="Semantic HID Fields" Margin="0,6,0,0"><ListView x:Name="FieldList"><ListView.View><GridView><GridViewColumn Header="Direction" DisplayMemberBinding="{Binding Direction}" Width="75"/><GridViewColumn Header="Kind" DisplayMemberBinding="{Binding Kind}" Width="130"/><GridViewColumn Header="Usage Page" DisplayMemberBinding="{Binding UsagePageText}" Width="100"/><GridViewColumn Header="Usages" DisplayMemberBinding="{Binding UsageSummary}" Width="190"/><GridViewColumn Header="Report" DisplayMemberBinding="{Binding ReportText}" Width="100"/><GridViewColumn Header="Bits" DisplayMemberBinding="{Binding BitsText}" Width="90"/></GridView></ListView.View></ListView></GroupBox></Grid></Grid><GroupBox Grid.Row="2" Header="Live HID Reports / Semantic Events"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions><DockPanel Margin="8"><Button x:Name="MonitorButton" DockPanel.Dock="Right" Width="120" Click="Monitor_Click">Start Monitor</Button><TextBlock VerticalAlignment="Center">Raw reports stay visible; decoded button/axis events appear below.</TextBlock></DockPanel><ListBox x:Name="ReportList" Grid.Row="1" Margin="8" FontFamily="Consolas"/><ListBox x:Name="SemanticList" Grid.Row="2" Margin="8" FontFamily="Consolas"/></Grid></GroupBox></Grid></Window>
